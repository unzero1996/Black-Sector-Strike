[matchmaking]
	#Maximum number of teams allowed per raid instance (including late join).
	#Default: 4
	# Default: 4
	# Range: 1 ~ 32
	maxTeamsPerInstance = 4
	#Time window (in minutes) after a match starts during which new teams
	#can late-join the same instance.
	#Default: 5
	# Default: 5
	# Range: 0 ~ 60
	lateJoinWindowMinutes = 5
	#Minimum number of teams required in queue before a new match starts.
	#Default: 2
	# Default: 1
	# Range: 1 ~ 32
	minTeamsToStart = 1
	#Tick interval for broadcasting queue status to players.
	#Default: 20 (1 second)
	# Default: 20
	# Range: 1 ~ 200
	broadcastIntervalTicks = 20

[raid]
	#Default raid timer duration in seconds.
	#Default: 2100 (35 minutes)
	# Default: 2100
	# Range: 60 ~ 7200
	defaultTimerSeconds = 2100
	#Maximum number of Scavs that can be alive in a raid instance at once.
	#Default: 8
	# Default: 8
	# Range: 0 ~ 100
	scavPopCap = 8
	#Interval (in seconds) between Scav spawn attempts while players are in raid.
	#Default: 12
	# Default: 12
	# Range: 1 ~ 300
	scavSpawnIntervalSeconds = 12
	#Grace period (in minutes) before a disconnected player is considered
	#to have abandoned the raid. Their gear is wiped on rejoin after this.
	#Default: 5
	# Default: 5
	# Range: 0 ~ 30
	disconnectGraceMinutes = 5
	#Countdown duration (in seconds) for extracting at an extraction point.
	#Default: 7.0
	# Default: 7.0
	# Range: 1.0 ~ 60.0
	extractTimeSeconds = 7.0
	#Minimum time spent in raid (in seconds) to avoid a 'Run-Through' status.
	#Below this threshold, no reputation is earned and XP is reduced.
	#Default: 420 (7 minutes)
	# Default: 420
	# Range: 0 ~ 3600
	runThroughThresholdSeconds = 420
